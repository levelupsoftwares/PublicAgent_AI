# =============================================================================
# PublicAgent AI — environment template
# Copy to .env and fill in real values:   cp .env.example .env
# =============================================================================
#
# Quick start (Docker, Groq LLM + OpenRouter embeddings):
#   1. cp .env.example .env
#   2. Edit the two keys below: GROQ_API_KEY + OPENROUTER_API_KEY
#   3. docker compose up --build
#   4. Open http://localhost:5173 and click "Continue as Demo Citizen".
#
# If both keys are left blank the backend auto-falls back to the offline
# "mock" LLM engine — the demo still works end-to-end with no API calls.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Docker Compose deployment (recommended — enables real pgvector RAG):
DATABASE_URL=postgresql+psycopg://publicagent:publicagent@postgres:5432/publicagent
# Local dev without Postgres (vector search falls back to in-process cosine):
# DATABASE_URL=sqlite:///./data/publicagent.db

# --- LLM provider -------------------------------------------------------------
# groq               = Groq chat (qwen3-32b) + OpenRouter embeddings  <- default
# gemini             = Google Gemini chat + Gemini embeddings
# model_studio      = Alibaba Cloud Model Studio (Qwen, OpenAI-compatible)
# openai_compatible = any generic OpenAI-compatible endpoint
# mock              = deterministic offline engine (no API key needed)
LLM_PROVIDER=groq

# --- Groq (chat) — get a key at https://console.groq.com/keys -----------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq's hosted Qwen3 line: qwen/qwen3-32b, qwen/qwen3-30b-a3b, qwen/qwen2.5-72b...
# (no qwen3-27b exists on Groq; qwen3-32b is the closest match)
GROQ_MODEL_NAME=qwen/qwen3-32b

# --- OpenRouter (embeddings) — get a key at https://openrouter.ai/keys -------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL_NAME=nvidia/nemotron-3-embed-1b:free
# IMPORTANT: EMBEDDING_DIM must match the model's output dimension. If you see
# "vector dimension mismatch" errors at startup, either:
#   - change EMBEDDING_DIM to match the model, OR
#   - pick a different EMBEDDING_MODEL_NAME that already produces this dimension,
#   - AND wipe the docker volume (docker compose down -v) so pgvector recreates
#     the kb_chunks.embedding column at the new width on first boot.
EMBEDDING_DIM=1024

# --- Google Gemini (chat + embeddings, or embeddings only) ---------------------
# Get a key at https://aistudio.google.com/apikey
# Option A — Gemini for EVERYTHING:  LLM_PROVIDER=gemini  (+ GEMINI_API_KEY)
# Option B — keep Groq chat, Gemini ONLY for embeddings:
#     EMBEDDING_PROVIDER=gemini  (+ GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding override: "" = follow LLM_PROVIDER; "gemini" = always Gemini.
EMBEDDING_PROVIDER=
# With Gemini embeddings set EMBEDDING_DIM above to 1536 (or 768 / 3072 —
# gemini-embedding-001 supports Matryoshka truncation). Changing the
# dimension later is safe: the backend wipes and re-embeds the KB on boot.

# --- Aliyun Model Studio (only used if LLM_PROVIDER=model_studio) -------------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Generic OpenAI-compatible (only used if LLM_PROVIDER=openai_compatible) --
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# --- Background follow-up checks -----------------------------------------------
FOLLOWUP_CHECK_INTERVAL_SECONDS=120

# --- File storage --------------------------------------------------------------
FILE_STORAGE_BACKEND=local        # local | oss (oss adapter is a stub; see DECISIONS.md)
FILE_STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Demo status progression for the mock government API (seconds) -------------
MOCK_STATUS_RECEIVED_AFTER_SECONDS=30
MOCK_STATUS_UNDER_REVIEW_AFTER_SECONDS=90
MOCK_STATUS_INVESTIGATING_AFTER_SECONDS=180
MOCK_STATUS_RESOLVED_AFTER_SECONDS=300

# --- Misc -----------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
ENV=development
SEED_ON_START=1
