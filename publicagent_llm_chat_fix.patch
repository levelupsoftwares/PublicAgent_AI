@@ -0,0 +1,20 @@
+"""Seed demo data on first boot (SEED_ON_START=1).
+
+The original module was never pushed to the repository; this restored stub is a
+no-op so that `from app.scripts.seed_demo_data import seed_if_empty` in
+app.main works regardless of the SEED_ON_START value. The demo is already fully
+functional without seeded rows: the knowledge base is ingested separately at
+startup (app.rag.ingest.ingest_kb) and the demo user is ensured by
+app.api.auth.ensure_demo_user.
+"""
+from __future__ import annotations
+
+import logging
+
+logger = logging.getLogger("publicagent.seed")
+
+
+def seed_if_empty(db=None) -> bool:
+    """Return True if demo data was created. Stub: nothing to create."""
+    logger.info("seed_if_empty: stub — no demo seeding required (skipping)")
+    return False
