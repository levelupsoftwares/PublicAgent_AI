index 0000000..de84aae
--- /dev/null
+++ b/backend/tests/test_embedding_dim_reconcile.py
@@ -0,0 +1,107 @@
+"""Tests for boot-time embedding-dimension reconciliation (hotfix patch 3).
+
+Regression context: a fresh install with EMBEDDING_DIM=1024 crashed at startup
+with pgvector's "expected 1024 dimensions, not 2048" because the configured
+OpenRouter model returns 2048-dim vectors. The reconciler must adopt the API's
+real dimension, re-ingest the KB at that width, and never let a probe failure
+crash the app.
+"""
+from __future__ import annotations
+
+import pytest
+
+from sqlalchemy import func, select
+
+from app.config import settings
+from app.models import KBChunk
+
+
+@pytest.fixture()
+def restore_dim():
+    """Preserve EMBEDDING_DIM across tests that mutate it."""
+    original = settings.EMBEDDING_DIM
+    yield
+    settings.EMBEDDING_DIM = original
+
+
+def _stub_llm(dim: int):
+    class _Stub:
+        provider_name = "stub"
+
+        def generate(self, messages, *, system=None, json_mode=False):
+            raise NotImplementedError
+
+        def embed(self, texts):
+            return [[0.5] * dim for _ in texts]
+
+    return _Stub()
+
+
+def test_reconcile_adopts_api_dimension(db, restore_dim, monkeypatch):
+    """API returns 8-dim while EMBEDDING_DIM=4 → adopt 8, re-ingest at 8."""
+    import app.rag.ingest as ingest_mod
+    from app.rag.ingest import ingest_kb, reconcile_embedding_dimension
+
+    settings.EMBEDDING_DIM = 4
+    ingest_kb(db)
+    assert db.execute(select(func.count()).select_from(KBChunk)).scalar() > 0
+
+    monkeypatch.setattr(ingest_mod, "get_llm_client", lambda: _stub_llm(8))
+    effective = reconcile_embedding_dimension(db)
+
+    assert effective == 8
+    assert settings.EMBEDDING_DIM == 8
+    for ch in db.execute(select(KBChunk)).scalars():
+        assert len(list(ch.embedding)) == 8
+    assert db.execute(select(func.count()).select_from(KBChunk)).scalar() > 0
+
+
+def test_reconcile_noop_when_dim_matches(db, restore_dim, monkeypatch):
+    """Probe agrees with EMBEDDING_DIM → no wipe, chunk ids unchanged."""
+    import app.rag.ingest as ingest_mod
+    from app.rag.ingest import ingest_kb, reconcile_embedding_dimension
+
+    settings.EMBEDDING_DIM = 6
+    ingest_kb(db)
+    ids_before = {c.id for c in db.execute(select(KBChunk)).scalars()}
+
+    monkeypatch.setattr(ingest_mod, "get_llm_client", lambda: _stub_llm(6))
+    assert reconcile_embedding_dimension(db) == 6
+
+    ids_after = {c.id for c in db.execute(select(KBChunk)).scalars()}
+    assert ids_before == ids_after
+
+
+def test_reconcile_survives_probe_failure(db, restore_dim, monkeypatch):
+    """Embedding API down → return None, no exception, app can still boot."""
+    import app.rag.ingest as ingest_mod
+    from app.rag.ingest import reconcile_embedding_dimension
+
+    class _Broken:
+        provider_name = "broken"
+
+        def generate(self, messages, *, system=None, json_mode=False):
+            raise NotImplementedError
+
+        def embed(self, texts):
+            raise RuntimeError("embedding API unreachable")
+
+    monkeypatch.setattr(ingest_mod, "get_llm_client", lambda: _Broken())
+    assert reconcile_embedding_dimension(db) is None
+
+
+def test_stored_drift_heal_still_works(db, restore_dim, monkeypatch):
+    """reingest_if_dim_changed: stored 4-dim rows vs EMBEDDING_DIM=8 → healed."""
+    import app.rag.ingest as ingest_mod
+    from app.rag.ingest import ingest_kb, reingest_if_dim_changed
+
+    settings.EMBEDDING_DIM = 4
+    ingest_kb(db)
+
+    # .env "changed" to 8 and the API agrees (probe = 8) — stored rows are stale.
+    settings.EMBEDDING_DIM = 8
+    monkeypatch.setattr(ingest_mod, "get_llm_client", lambda: _stub_llm(8))
+    assert reingest_if_dim_changed(db) is True
+
+    for ch in db.execute(select(KBChunk)).scalars():
+        assert len(list(ch.embedding)) == 8
