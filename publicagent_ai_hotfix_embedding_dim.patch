+
+def reconcile_embedding_dimension(db: Session) -> int | None:
+    """Probe the live embedding API and reconcile EMBEDDING_DIM + the schema.
+
+    Catches the fresh-install crash pgvector reports as::
+
+        psycopg.errors.DataException: expected 1024 dimensions, not 2048
+
+    This happens when the configured embedding model's real output width
+    differs from EMBEDDING_DIM (wrong default in .env, provider changed the
+    model, or user swapped EMBEDDING_MODEL_NAME without updating the dim).
+    The stored-drift heal (reingest_if_dim_changed) cannot see it on an empty
+    database — there are no rows to compare yet — so at boot we ask the
+    provider itself for one vector and trust that answer:
+
+    1. probe the API with a single tiny string → actual dimension
+    2. if it differs from settings.EMBEDDING_DIM: wipe the KB, recreate the
+       pgvector column at the actual width (Postgres), adopt the actual
+       dimension in-process, and re-ingest
+    3. log a loud hint to also update EMBEDDING_DIM in .env
+
+    Returns the effective dimension (int) or None when the probe failed
+    (offline / bad key) — the caller decides whether boot can continue.
+    """
+    llm = get_llm_client()
+    try:
+        probe = llm.embed(["embedding dimension probe"])
+        actual = len(probe[0]) if probe and probe[0] else 0
+    except Exception:
+        logger.exception(
+            "Embedding dimension probe failed — skipping reconciliation. "
+            "RAG will stay empty until the embedding backend is reachable.")
+        return None
+    if not actual:
+        logger.error("Embedding probe returned an empty vector — skipping "
+                     "reconciliation.")
+        return None
+
+    if actual == settings.EMBEDDING_DIM:
+        return actual
+
+    logger.warning(
+        "EMBEDDING_DIM=%s but the active embedding backend returns "
+        "%s-dimensional vectors — reconciling the schema and re-embedding "
+        "the knowledge base. Update EMBEDDING_DIM=%s in .env to make this "
+        "fix permanent and skip the extra work on future boots.",
+        settings.EMBEDDING_DIM, actual, actual)
+
+    # Fresh DB → table exists at the stale width with no rows; DB with data →
+    # rows have the old width. Both are fixed by: wipe + resize + re-ingest.
+    if not _wipe_kb(db, resize_to=actual):
+        return None
+    settings.EMBEDDING_DIM = actual  # adopt in-process (mock/gemini read it live)
+    ingest_kb(db)
+    return actual
